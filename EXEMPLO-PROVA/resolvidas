/*
4) criar uma FUNCAO de nome FUNC_DIA99 que receba uma data qualquer, e retorne o dia da mesma com 2 algarismos.
Se o fromato da data informada estiver errado, emitir mensagem de erro orientando o formato adequado 
para a execucao da funcao

---------------------------------------ORGANIZANDO---------------------------------------

--> o que a funcao precisa fzr?
- receber uma data como argumento
- verificar se o formato é valido
    se SIM -> retornar a msm data com 2 algarismos (ex: 01, 02...)
    se NAO -> retornar mensagem de erro dizendo qual formato é aceito
    
--> como validar a data?
- usar um bloco EXCEPTION>
* tentamos converter a entrada para DATE usando o formato desejado
  * se der ERRO, capturams e retornamos a mensagem
  
--> como extrair o dia com dois digitos?
- usar to_char --> serve para fzr formatacao da saida dos dados 

TO_CHAT(minha_data, 'DD')

*/

CREATE OR REPLACE FUNCTION FUNC_DIA99(p_data IN VARCHAR2)
return VARCHAR2
IS
  v_data DATE;
BEGIN
  -- tentativa de converter 
  v_data := TO_DATE(p_data, 'DD/MM/YYYY');
  
  -- retorna o dia com dois digitos
  RETURN TO_CHAR(v_data, 'DD')

EXCEPTION
  WHEN OTHER THEN
    RETURN 'ERRO: Informe a data no formato DD/MM/YYYY';
  END;
  
---> COMO USAR A FUNCAO ACIMA?
SELECT FUNC_DIA99('05/12/2024') FROM DUAL;


