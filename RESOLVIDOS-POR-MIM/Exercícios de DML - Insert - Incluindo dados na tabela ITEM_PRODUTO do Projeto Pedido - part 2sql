
-- Inserir dados na tabela ITEM_PRODUTO em conformidade com os enunciados a seguir:

/*1. Produto 207 para todos os pedidos pares e ano menor 2018, com a quantidade 100 e
preço unitário R$ 10.00*/


INSERT INTO ITEM_PRODUTO (CODIGO_PRO, NUMERO_PED, QUANTIDADE, PRECO_UNITARIO)
SELECT 207, P.NUMERO, 100, 10.00
FROM PEDIDO P
WHERE MOD(P.NUMERO, 2) = 0 /*MOD --> Geralmente usado p ver se é par ou impar. Serve p calcular resto da divisao onde: MOD(dividendo, divisor)*/
  AND EXTRACT(YEAR FROM P.DATA) < 2018;

