/*
1) fazer uma query para selecionar os armazens ativos (situacao) localizsdos nos estados 
de Sao Paulo ou Minas Gerais.
* Mostrar: Nome do armazem e a cidade em que esta localizado
* Ordenacao: Decrescente pelo nome do armazem 


-------------------ORGANIZADNO-------------------
--> o que a questao pede?
* selecionar armazens ATIVOS --> situacao = 'ATIVO'
  nome do armazem AS ARMAZEM
  cidade
* filtrar pelos localizados em SP e MG --> uf IN ('SP', 'MG')
* ordenar por nome DESC

--> CAMPOS DA TABELA
- nome
- cidade
- uf
- situacao

*/


SELECT
  nome AS ARMAZEM,
  cidade
WHERE
  situacao = 'ATIVO'
  AND uf IN ('SP', 'MG')
ORDER BY
  nome DESC;
  
  
