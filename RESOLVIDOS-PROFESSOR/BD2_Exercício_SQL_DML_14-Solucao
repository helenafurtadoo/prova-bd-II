-- a. Criar a view que mostra estoque constante no BD Pedidos.
-- (VIEW_ESTOQUE) contendo os dados indicados no modelo apresentado.

-- RESOLUÇÃO 1:----

CREATE OR REPLACE VIEW VIEW_ESTOQUE
AS
SELECT PRODUTO.DESCRICAO AS PRODUTO,
A.QUANTIDADE_ENT AS QUANTIDADE_ADQUIRIDA,
CASE
WHEN A.QUANTIDADE_ENT - NVL(B.QUANTIDADE_SAI,0) < 0
THEN NVL(A.QUANTIDADE_ENT,0)
ELSE NVL(B.QUANTIDADE_SAI,0)
END AS QUANTIDADE_SAIDA,
CASE
WHEN A.QUANTIDADE_ENT - NVL(B.QUANTIDADE_SAI,0) >= 0
THEN A.QUANTIDADE_ENT - NVL(B.QUANTIDADE_SAI,0)
ELSE 0
END AS DISPONIVEL,
PRODUTO.UNID_MEDIDA
FROM PRODUTO LEFT JOIN
(
SELECT CODIGO_PRO,
SUM(QUANTIDADE) AS QUANTIDADE_ENT
FROM ESTOQUE
GROUP BY CODIGO_PRO
) A ON PRODUTO.CODIGO=A.CODIGO_PRO LEFT JOIN
(
SELECT CODIGO_PRO,
SUM(QUANTIDADE) AS QUANTIDADE_SAI
FROM ITEM_PRODUTO
GROUP BY CODIGO_PRO
) B ON B.CODIGO_PRO=PRODUTO.CODIGO;



-- RESOLUÇÃO 2:------
CREATE OR REPLACE VIEW VIEW_ESTOQUE
AS
WITH
ENTRADAS AS( SELECT ESTOQUE.CODIGO_PRO,
SUM(ESTOQUE.QUANTIDADE) AS QUANTIDADE_ENT
FROM ESTOQUE

GROUP BY ESTOQUE.CODIGO_PRO

),
SAIDAS AS ( SELECT ITEM_PRODUTO.CODIGO_PRO,
SUM(ITEM_PRODUTO.QUANTIDADE) AS QUANTIDADE_SAI
FROM ITEM_PRODUTO

GROUP BY ITEM_PRODUTO.CODIGO_PRO

)
SELECT PRODUTO.DESCRICAO AS PRODUTO,
COALESCE (ENTRADAS.QUANTIDADE_ENT,0) AS QUANTIDADE_ADQUIRIDA,
CASE
WHEN COALESCE (ENTRADAS.QUANTIDADE_ENT,0) -
COALESCE (SAIDAS.QUANTIDADE_SAI,0) < 0
THEN COALESCE (ENTRADAS.QUANTIDADE_ENT,0)
ELSE COALESCE (SAIDAS.QUANTIDADE_SAI,0)
END AS QUANTIDADE_SAIDA,
GREATEST (0, COALESCE (ENTRADAS.QUANTIDADE_ENT,0) -
COALESCE (SAIDAS.QUANTIDADE_SAI,0)) AS DISPONIVEL,
PRODUTO.UNID_MEDIDA
FROM PRODUTO LEFT JOIN
ENTRADAS ON PRODUTO.CODIGO=ENTRADAS.CODIGO_PRO LEFT JOIN
SAIDAS ON PRODUTO.CODIGO=SAIDAS.CODIGO_PRO;